<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <Step><Name>KVM-Get-Token</Name></Step>
            <Step>
                <Name>JS-Set-Flags</Name>
                <Condition>request.verb = "POST"</Condition>
            </Step>
            <Step>
                <Name>Py-Legacy</Name>
                <Condition>request.verb = "POST"</Condition>
            </Step>
            <Step>
                <Name>JS-Call-Inventory</Name>
                <Condition>request.verb = "POST"</Condition>
            </Step>
        </Request>
        <Response>
            <Step><Name>AM-CORS</Name></Step>
        </Response>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <Step><Name>Stats-Orders</Name></Step>
            <Step><Name>ML-File</Name></Step>
        </Response>
    </PostFlow>
    <HTTPProxyConnection>
        <BasePath>/legacy/v1</BasePath>
        <VirtualHost>default</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="node">
        <Condition>proxy.pathsuffix MatchesPath "/report/**"</Condition>
        <TargetEndpoint>node</TargetEndpoint>
    </RouteRule>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
