<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="AM-CORS-Origin">
    <DisplayName>AM-CORS-Origin</DisplayName>
    <Set>
        <Headers>
            <Header name="Access-Control-Allow-Origin">https://portal.example.com</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
