<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="AM-CORS-Methods">
    <DisplayName>AM-CORS-Methods</DisplayName>
    <Set>
        <Headers>
            <Header name="Access-Control-Allow-Methods">GET,PUT,DELETE</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
