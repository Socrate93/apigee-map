<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:oasis:names:tc:SAML:2.0:assertion" elementFormDefault="qualified">
    <xs:element name="Assertion">
        <xs:complexType>
            <xs:sequence>
                <xs:any processContents="lax" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="ID" type="xs:ID" use="required"/>
            <xs:attribute name="Version" type="xs:string" use="required" fixed="2.0"/>
            <xs:attribute name="IssueInstant" type="xs:dateTime" use="required"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
