<OAuthV2 async="false" continueOnError="false" enabled="true" name="OA-Token-Password">
    <Operation>GenerateAccessToken</Operation>
    <ExpiresIn>1800000</ExpiresIn>
    <RefreshTokenExpiresIn>2592000000</RefreshTokenExpiresIn>
    <SupportedGrantTypes>
        <GrantType>password</GrantType>
    </SupportedGrantTypes>
    <GrantType>request.formparam.grant_type</GrantType>
    <UserName>token.username</UserName>
    <PassWord>private.ldap.password</PassWord>
    <Attributes>
        <Attribute name="sub" ref="token.username" display="true"/>
    </Attributes>
    <GenerateResponse enabled="true"/>
</OAuthV2>
