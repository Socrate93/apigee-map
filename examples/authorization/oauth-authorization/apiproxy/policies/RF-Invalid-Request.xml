<RaiseFault async="false" continueOnError="false" enabled="true" name="RF-Invalid-Request">
    <FaultResponse>
        <Set>
            <StatusCode>400</StatusCode>
            <Payload contentType="application/json" variablePrefix="@" variableSuffix="#">{"error": "invalid_request", "error_description": "@authorize.error#"}</Payload>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
