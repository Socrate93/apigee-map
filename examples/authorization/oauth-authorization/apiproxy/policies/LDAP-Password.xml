<Ldap async="false" continueOnError="false" enabled="true" name="LDAP-Password">
    <LdapResource>corporate-directory</LdapResource>
    <Authentication>
        <UserName ref="token.username"/>
        <Password ref="request.formparam.password"/>
        <Scope>subtree</Scope>
        <BaseDN>ou=people,dc=example,dc=com</BaseDN>
    </Authentication>
</Ldap>
