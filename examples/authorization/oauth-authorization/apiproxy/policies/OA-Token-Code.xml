<OAuthV2 async="false" continueOnError="false" enabled="true" name="OA-Token-Code">
    <Operation>GenerateAccessToken</Operation>
    <ExpiresIn>1800000</ExpiresIn>
    <RefreshTokenExpiresIn>2592000000</RefreshTokenExpiresIn>
    <SupportedGrantTypes>
        <GrantType>authorization_code</GrantType>
    </SupportedGrantTypes>
    <GrantType>request.formparam.grant_type</GrantType>
    <Code>token.code</Code>
    <Attributes>
        <Attribute name="sub" ref="oauthv2authcode.GOI-Code.sub" display="true"/>
        <Attribute name="idp_access_token" ref="oauthv2authcode.GOI-Code.idp_access_token" display="false"/>
    </Attributes>
    <GenerateResponse enabled="true"/>
</OAuthV2>
