<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-Route-Discovery">
    <AssignVariable>
        <Name>route.to.idp</Name>
        <Value>true</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>idp.path</Name>
        <Value>/.well-known/openid-configuration</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>target.copy.pathsuffix</Name>
        <Value>false</Value>
    </AssignVariable>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
</AssignMessage>
