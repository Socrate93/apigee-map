<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-Cors-Headers">
    <Set>
        <Headers>
            <Header name="Access-Control-Allow-Origin">{cors.origin}</Header>
            <Header name="Access-Control-Allow-Methods">GET, POST, OPTIONS</Header>
            <Header name="Access-Control-Allow-Headers">Authorization, Content-Type</Header>
            <Header name="Access-Control-Max-Age">3600</Header>
            <Header name="Vary">Origin</Header>
        </Headers>
    </Set>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
