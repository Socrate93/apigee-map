<KeyValueMapOperations async="false" continueOnError="false" enabled="true" name="KVM-Get-Secrets" mapIdentifier="oauth-secrets">
    <Scope>environment</Scope>
    <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
    <Get assignTo="private.idp.client_id"><Key><Parameter>idp_client_id</Parameter></Key></Get>
    <Get assignTo="private.idp.client_secret"><Key><Parameter>idp_client_secret</Parameter></Key></Get>
    <Get assignTo="private.jwt.signing_key"><Key><Parameter>jwt_signing_key</Parameter></Key></Get>
    <Get assignTo="jwt.key_id"><Key><Parameter>jwt_key_id</Parameter></Key></Get>
</KeyValueMapOperations>
