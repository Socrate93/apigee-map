<ExtractVariables async="false" continueOnError="false" enabled="true" name="EV-Client-Secret">
    <Source>AccessEntity.AE-Client-App</Source>
    <VariablePrefix>private.app</VariablePrefix>
    <XMLPayload>
        <Variable name="consumer_secret" type="string">
            <XPath>/ConsumerKey/ConsumerSecret</XPath>
        </Variable>
        <Variable name="public_key" type="string">
            <XPath>/ConsumerKey/Attributes/Attribute[Name='public_key']/Value</XPath>
        </Variable>
    </XMLPayload>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</ExtractVariables>
