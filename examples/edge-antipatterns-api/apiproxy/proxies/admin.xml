<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="admin">
    <PreFlow name="PreFlow">
        <Request>
            <Step><Name>VA-Key</Name></Step>
            <Step><Name>SC-Mgmt-Kvm</Name></Step>
            <Step><Name>SC-Mgmt-Products</Name></Step>
            <Step><Name>JS-Get-App</Name></Step>
        </Request>
    </PreFlow>
    <HTTPProxyConnection>
        <BasePath>/catalog/admin</BasePath>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>
